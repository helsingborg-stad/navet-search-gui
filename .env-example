# Copy the keys below into the Kubernetes navet-search-gui-secret. Do not
# commit their real values. PREDIS and VALKEY_PASSWORD must use the same
# password; Valkey runs as a sidecar and is reached only through loopback.
MS_AUTH=
MS_NAVET=
MS_NAVET_AUTH=
ENCRYPT_VECTOR=
ENCRYPT_KEY=
ENCRYPT_CIPHER=
PREDIS=tcp://:replace-with-valkey-password@127.0.0.1:6379
VALKEY_PASSWORD=
DEBUG=false
AD_GROUPS=
SESSION_COOKIE_NAME=
SESSION_COOKIE_EXPIRES=
